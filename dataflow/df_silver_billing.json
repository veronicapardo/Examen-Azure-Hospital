{
	"name": "df_silver_billing",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_billing",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "dw_silver_admissions",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_billing",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "split1"
				},
				{
					"name": "exists1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          billing_id as string,",
				"          admission_id as string,",
				"          charge_type as string,",
				"          amount as string,",
				"          payment_status as string,",
				"          payment_date as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT admission_id FROM silver.admissions',",
				"     format: 'query') ~> source2",
				"source1 derive(billing_id = toInteger(trim(billing_id)),",
				"          admission_id = toInteger(trim(admission_id)),",
				"          charge_type = iif(\r",
				"    isNull(charge_type) || trim(charge_type) == '',\r",
				"    toString(null()),\r",
				"\r",
				"    iif(\r",
				"        lower(trim(charge_type)) == 'surgery',\r",
				"        'Surgery',\r",
				"\r",
				"        iif(\r",
				"            lower(trim(charge_type)) == 'medication',\r",
				"            'Medication',\r",
				"\r",
				"            iif(\r",
				"                lower(trim(charge_type)) == 'imaging',\r",
				"                'Imaging',\r",
				"\r",
				"                iif(\r",
				"                    lower(trim(charge_type)) == 'room',\r",
				"                    'Room',\r",
				"\r",
				"                    iif(\r",
				"                        lower(trim(charge_type)) == 'consultation',\r",
				"                        'Consultation',\r",
				"\r",
				"                        iif(\r",
				"                            lower(trim(charge_type)) == 'lab test',\r",
				"                            'Lab Test',\r",
				"\r",
				"                            toString(null())\r",
				"                        )\r",
				"                    )\r",
				"                )\r",
				"            )\r",
				"        )\r",
				"    )\r",
				"),",
				"          payment_status = iif(\r",
				"    lower(trim(payment_status)) == 'paid',\r",
				"    'Paid',\r",
				"\r",
				"    iif(\r",
				"        lower(trim(payment_status)) == 'pending',\r",
				"        'Pending',\r",
				"\r",
				"        iif(\r",
				"            lower(trim(payment_status)) == 'unpaid',\r",
				"            'Unpaid',\r",
				"\r",
				"            iif(\r",
				"                lower(trim(payment_status)) == 'overdue',\r",
				"                'Overdue',\r",
				"\r",
				"                toString(null())\r",
				"            )\r",
				"        )\r",
				"    )\r",
				")) ~> derivedColumn1",
				"derivedColumn1 derive(amount = iif( isNull(amount) || trim(amount) == '',         toDecimal(null(),12,2),         toDecimal(                replace(                         replace(                                 replace(                                         trim(amount),                                         'USD',                                         ''                                     ),                                     '$',                                     ''                                 ),                                 ',',                                 ''                             ),                             12,                             2                         ) ),",
				"          payment_date = iif(\r",
				"    isNull(payment_date) || trim(payment_date) == '',\r",
				"    toDate(null()),\r",
				"\r",
				"    iif(\r",
				"        regexMatch(\r",
				"            trim(payment_date),\r",
				"            '^[0-9]{4}-[0-9]{1,2}-[0-9]{1,2}$'\r",
				"        ),\r",
				"        toDate(\r",
				"            trim(payment_date),\r",
				"            'yyyy-MM-dd'\r",
				"        ),\r",
				"\r",
				"        iif(\r",
				"            regexMatch(\r",
				"                trim(payment_date),\r",
				"                '^[0-9]{1,2}/[0-9]{1,2}/[0-9]{4}$'\r",
				"            ),\r",
				"            toDate(\r",
				"                trim(payment_date),\r",
				"                'MM/dd/yyyy'\r",
				"            ),\r",
				"\r",
				"            iif(\r",
				"                regexMatch(\r",
				"                    trim(payment_date),\r",
				"                    '^[0-9]{1,2}-[A-Za-z]{3}-[0-9]{4}$'\r",
				"                ),\r",
				"                toDate(\r",
				"                    trim(payment_date),\r",
				"                    'dd-MMM-yyyy'\r",
				"                ),\r",
				"\r",
				"                iif(\r",
				"                    regexMatch(\r",
				"                        trim(payment_date),\r",
				"                        '^[0-9]{1,2}-[0-9]{1,2}-[0-9]{2}$'\r",
				"                    ),\r",
				"                    toDate(\r",
				"                        trim(payment_date),\r",
				"                        'MM-dd-yy'\r",
				"                    ),\r",
				"\r",
				"                    iif(\r",
				"                        regexMatch(\r",
				"                            trim(payment_date),\r",
				"                            '^[A-Za-z]+ [0-9]{1,2}, [0-9]{4}$'\r",
				"                        ),\r",
				"                        toDate(\r",
				"                            trim(payment_date),\r",
				"                            'MMMM dd, yyyy'\r",
				"                        ),\r",
				"\r",
				"                        toDate(null())\r",
				"                    )\r",
				"                )\r",
				"            )\r",
				"        )\r",
				"    )\r",
				")) ~> derivedColumn2",
				"exists1 split(billing_id >= 1 && admission_id >= 1 && admission_id <= 1800 && !isNull(charge_type) && !isNull(amount) && amount > 0 && !isNull(payment_status),",
				"     disjoint: false) ~> split1@(Validos, Rechazados)",
				"derivedColumn2, source2 exists(derivedColumn1@admission_id == source2@admission_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists1",
				"split1@Validos sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          billing_id as integer,",
				"          admission_id as integer,",
				"          charge_type as string,",
				"          amount as decimal(12,2),",
				"          payment_status as string,",
				"          payment_date as date",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          billing_id,",
				"          admission_id,",
				"          charge_type,",
				"          amount,",
				"          payment_status,",
				"          payment_date",
				"     )) ~> sink1"
			]
		}
	}
}