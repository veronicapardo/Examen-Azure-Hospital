{
	"name": "df_silver_admissions",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_admissions",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_admissions",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          admission_id as string,",
				"          patient_id as string,",
				"          admission_date as string,",
				"          discharge_date as string,",
				"          department as string,",
				"          attending_doctor_id as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(admission_id = toInteger(trim(admission_id)),",
				"          patient_id = toInteger(trim(patient_id)),",
				"          attending_doctor_id = toInteger(trim(attending_doctor_id)),",
				"          admission_date = coalesce(     \r",
				"    toDate(trim(admission_date), 'yyyy-MM-dd'),     \r",
				"    toDate(trim(admission_date), 'MM-dd-yy'),     \r",
				"    toDate(trim(admission_date), 'MM/dd/yyyy'),     \r",
				"    toDate(trim(admission_date), 'dd-MMM-yyyy'),     \r",
				"    toDate(trim(admission_date), 'MMMM dd, yyyy') ),",
				"          discharge_date = iif(\r",
				"    isNull(discharge_date) || trim(discharge_date) == '',\r",
				"     toDate(null()),\r",
				"\r",
				"    iif(\r",
				"        regexMatch(\r",
				"            trim(discharge_date),\r",
				"            '^[0-9]{4}-[0-9]{1,2}-[0-9]{1,2}$'\r",
				"        ),\r",
				"        toDate(\r",
				"            trim(discharge_date),\r",
				"            'yyyy-MM-dd'\r",
				"        ),\r",
				"\r",
				"        iif(\r",
				"            regexMatch(\r",
				"                trim(discharge_date),\r",
				"                '^[0-9]{1,2}/[0-9]{1,2}/[0-9]{4}$'\r",
				"            ),\r",
				"            toDate(\r",
				"                trim(discharge_date),\r",
				"                'MM/dd/yyyy'\r",
				"            ),\r",
				"\r",
				"            iif(\r",
				"                regexMatch(\r",
				"                    trim(discharge_date),\r",
				"                    '^[0-9]{1,2}-[0-9]{1,2}-[0-9]{2}$'\r",
				"                ),\r",
				"                toDate(\r",
				"                    trim(discharge_date),\r",
				"                    'MM-dd-yy'\r",
				"                ),\r",
				"\r",
				"                iif(\r",
				"                    regexMatch(\r",
				"                        trim(discharge_date),\r",
				"                        '^[0-9]{1,2}-[A-Za-z]{3}-[0-9]{4}$'\r",
				"                    ),\r",
				"                    toDate(\r",
				"                        trim(discharge_date),\r",
				"                        'dd-MMM-yyyy'\r",
				"                    ),\r",
				"\r",
				"                    iif(\r",
				"                        regexMatch(\r",
				"                            trim(discharge_date),\r",
				"                            '^[A-Za-z]+ [0-9]{1,2}, [0-9]{4}$'\r",
				"                        ),\r",
				"                        toDate(\r",
				"                            trim(discharge_date),\r",
				"                            'MMMM dd, yyyy'\r",
				"                        ),\r",
				"\r",
				"                        toDate(null())\r",
				"                    )\r",
				"                )\r",
				"            )\r",
				"        )\r",
				"    )\r",
				"),",
				"          department = case(     in(['cardiology', 'cardio', 'cardiolgy'], lower(trim(department))), 'Cardiology',     in(['emergency', 'emergancy', 'er'], lower(trim(department))), 'Emergency',     in(['general surgery', 'generalsurgery', 'gen surg'], lower(trim(department))), 'General Surgery',     in(['neurology', 'neuro', 'nuerology'], lower(trim(department))), 'Neurology',     in(['oncology', 'onco', 'oncologyy'], lower(trim(department))), 'Oncology',     in(['orthopedics', 'orthopaedics', 'ortho'], lower(trim(department))), 'Orthopedics',     in(['pediatrics', 'paediatrics', 'peds'], lower(trim(department))), 'Pediatrics',     'Unknown' )) ~> derivedColumn1",
				"derivedColumn1 split(admission_id >= 1 && patient_id >= 1 && patient_id <= 1015 && !isNull(admission_date) && !isNull(department) && !isNull(attending_doctor_id) && (     isNull(discharge_date)     ||     discharge_date >= admission_date ),",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          admission_id,",
				"          patient_id,",
				"          admission_date,",
				"          discharge_date,",
				"          department,",
				"          attending_doctor_id",
				"     )) ~> sink1"
			]
		}
	}
}