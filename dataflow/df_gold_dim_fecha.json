{
	"name": "df_gold_dim_fecha",
	"properties": {
		"folder": {
			"name": "Gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "sourse1"
				},
				{
					"name": "surrogateKey1",
					"description": "sk_dias"
				}
			],
			"scriptLines": [
				"source(allowSchemaDrift: true,",
				"     validateSchema: false) ~> source1",
				"source1 derive(fecha_inicio = toDate('2023-01-01','yyyy-MM-dd')) ~> sourse1",
				"sourse1 keyGenerate(output(numero_dia as long),",
				"     startAt: 0L,",
				"     stepValue: 1L) ~> surrogateKey1"
			]
		}
	}
}